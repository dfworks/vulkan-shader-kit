#version 460
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
struct Particle { vec4 position; vec4 velocity; };
layout(set = 0, binding = 0, std430) buffer Particles { Particle particles[]; };
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D heat;
layout(push_constant) uniform Push { float dt; uint count; } push;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= push.count) return;
    particles[i].position += particles[i].velocity * push.dt;
    imageStore(heat, ivec2(particles[i].position.xy), vec4(1.0));
}
